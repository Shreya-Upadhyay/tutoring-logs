// LVAEP Tutoring Logs — data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Every person who signs in. Anyone can tutor students of their own; the
/// isStaff flag additionally grants read-only visibility across the whole
/// program, so one person can be both a tutor and LVAEP staff.
model Tutor {
  id        String    @id @default(cuid())
  isStaff   Boolean   @default(false)
  // Nullable so accounts created before passwords existed still load; those
  // accounts finish setting up via the claim flow on the login page.
  email        String? @unique
  passwordHash String?
  firstName String
  lastName  String? // optional so single-name entries are still possible
  site      String? // tutoring site / location
  days      String? // e.g. "Tuesdays & Thursdays"
  times     String? // e.g. "4:00 - 5:30 PM"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]
}

model Student {
  id        String   @id @default(cuid())
  tutorId   String
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String? // optional so single-name entries are still possible
  site      String? // tutoring site
  days      String? // day(s) they meet
  times     String? // time(s) they meet

  active       Boolean   @default(true)
  stoppedAt    DateTime?
  stoppedReason String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attendance  AttendanceEntry[]
  achievements Achievement[]

  @@index([tutorId])
}

enum AttendanceType {
  HOURS // numeric hours tutored
  TUTOR_ABSENT // TA
  STUDENT_ABSENT // SA
  HOLIDAY // H
}

model AttendanceEntry {
  id        String         @id @default(cuid())
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime // the calendar date of the session
  type      AttendanceType @default(HOURS)
  hours     Float? // only set when type = HOURS
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([studentId, date])
  @@index([studentId])
}

enum AchievementCategory {
  ECONOMIC
  EDUCATIONAL
  FAMILY
  SOCIETAL
  OTHER
}

model Achievement {
  id          String              @id @default(cuid())
  studentId   String
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category    AchievementCategory
  itemKey     String // stable key from the catalog, or a generated key for OTHER
  label       String // display text (denormalized so custom "Other" text is preserved)
  attained    Boolean             @default(false)
  attainedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([studentId, itemKey])
  @@index([studentId])
}
