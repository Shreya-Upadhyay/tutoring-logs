# Postgres connection string (Vercel Postgres / Neon / Supabase all work).
# On Vercel: Project -> Storage -> Create Database -> Postgres, then this is
# added for you automatically. For local dev, paste a connection string from
# a free Neon project (https://neon.tech) or a local Postgres instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
